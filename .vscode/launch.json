{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "sqlmem: context pack (AdventureWorks example)",
      "type": "debugpy",
      "request": "launch",
      "module": "sqlmem",
      "args": ["context", "--kb", "kb/adventureworks2025", "Which vendors supply helmets?"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "${file}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "eval: retrieval (BM25)",
      "type": "debugpy",
      "request": "launch",
      "module": "evals.run_retrieval",
      "args": ["--embedder", "none", "--ablate-kg"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
